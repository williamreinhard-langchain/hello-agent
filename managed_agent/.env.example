# LangSmith API key: authenticates `mda dev` / `mda deploy`. Reserved, so it is not uploaded as a deployment secret.
LANGSMITH_API_KEY=
# Region/workspace the CLI deploys to. Defaults to GCP US (https://api.smith.langchain.com) when unset.
# The API key must belong to this region. Azure: https://azure.api.smith.langchain.com
# LANGSMITH_ENDPOINT=
# LANGSMITH_WORKSPACE_ID=

# Model calls go through the LangSmith LLM Gateway. MODEL is "langsmith:<gateway model id>".
MODEL=langsmith:openai/gpt-4o-mini
# Workspace-scoped LangSmith key with gateway:invoke. Forwarded to the deployment as a secret.
LANGSMITH_GATEWAY_API_KEY=
# BYOC only: the data plane's gateway, e.g. https://<data-plane-id>.azure.langchain-byoc.com/gateway
# LANGSMITH_GATEWAY=

# MCP backend. Leave unset to use the in-process copies of the tools.
# MEMORY_MCP_URL=https://<reachable-host>/mcp
