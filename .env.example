# LLM calls go through the LangSmith LLM Gateway. MODEL is "langsmith:<gateway model id>"
# (list ids with: curl https://gateway.smith.langchain.com/v1/models -H "Authorization: Bearer $LANGSMITH_API_KEY").
MODEL=langsmith:openai/gpt-4o-mini
# Workspace-scoped LangSmith key with gateway:invoke. Falls back to LANGSMITH_API_KEY if unset.
LANGSMITH_GATEWAY_API_KEY=
# Optional: non-US region / self-hosted gateway host, e.g. https://eu.gateway.smith.langchain.com
# LANGSMITH_GATEWAY=

# MCP backends. Leave MEMORY_MCP_URL unset to use the in-process copies of the tools.
# MEMORY_MCP_URL=http://localhost:8000/mcp
# SKILLS_MCP_URL=

AGENT_NAME=hello-agent

# Tracing (local dev; set automatically on LangSmith Deployment)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=hello-agent
